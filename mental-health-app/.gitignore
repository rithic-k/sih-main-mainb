# ---- Python / FastAPI (/backend, /ml) ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
*.sqlite3
.pytest_cache/
.mypy_cache/
instance/

# ---- Flutter / Dart (/app) ----
app/.dart_tool/
app/.flutter-plugins
